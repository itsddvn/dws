{
  "name": "devin-switcher",
  "version": "0.1.0",
  "private": true,
  "description": "Local Devin CLI profile switcher with quota-aware account selection.",
  "bin": {
    "dsw": "./bin/dsw"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.6",
    "commander": "^14.0.2",
    "execa": "^9.6.0",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "tempy": "^3.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.14"
  }
}

{
  "name": "@itsddvn/dsw",
  "version": "0.4.1",
  "description": "Devin CLI account switcher: rotate between accounts and run devin under isolated profiles.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsddvn/dws.git"
  },
  "homepage": "https://github.com/itsddvn/dws#readme",
  "bugs": {
    "url": "https://github.com/itsddvn/dws/issues"
  },
  "bin": {
    "dsw": "bin/dsw"
  },
  "files": [
    "bin",
    "dist/src",
    "scripts/ensure-tmux.js",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "prepack": "npm run build",
    "dev": "tsx src/cli/index.ts",
    "postinstall": "node scripts/ensure-tmux.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.14"
  }
}
